{
  "name": "vitrine-rmm-backend",
  "version": "2.5.0",
  "type": "module",
  "description": "Backend API and MeshCentral 2 bridge for Vitrine RMM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "node --input-type=module -e \"import('./dist/db/index.js').then(m => m.initDatabase())\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^11.8.1",
    "content-disposition": "^0.5.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.24",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
